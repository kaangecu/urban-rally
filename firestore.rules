rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ====================================
    // HELPER FUNCTIONS
    // ====================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isTeamOwner(teamId) {
      return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUserId;
    }
    
    function isTeamMember(teamId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUserIds;
    }
    
    function isUserOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function belongsToTenant(tenantId) {
      return request.resource.data.tenantId == tenantId;
    }
    
    // CRITICAL: All queries MUST include tenantId filter to prevent cross-tenant data leaks
    function hasTenantIdInQuery() {
      return request.query.limit == null || 'tenantId' in request.query;
    }
    
    // ====================================
    // TENANTS COLLECTION
    // ====================================
    
    match /tenants/{tenantId} {
      // Public read for branding (logo, colors, name)
      allow read: if true;
      
      // ⚠️ DEVELOPMENT: Allow writes for test data setup
      // TODO: Change to 'if false' in production
      allow write: if true;
    }
    
    // ====================================
    // EVENTS COLLECTION
    // ====================================
    
    match /events/{eventId} {
      // Public read for active events (map bounds, start/end dates)
      allow read: if true;
      
      // ⚠️ DEVELOPMENT: Allow writes for test data setup
      // TODO: Change to 'if false' in production
      allow write: if true;
    }
    
    // ====================================
    // TEAMS COLLECTION (Strict Isolation)
    // ====================================
    
    match /teams/{teamId} {
      // Allow reading by accessCode for login (before auth)
      // OR if user is a team member (after auth)
      allow read: if isTeamMember(teamId) 
                  || (!isAuthenticated() && request.query != null)
                  || true; // ⚠️ DEVELOPMENT: Open read access
      
      // Only team owner can update team settings
      // CANNOT change tenantId, eventId, or accessCode (prevent hijacking)
      // CAN update: teamDisplayName, maxMembers, ownerUserId (for ownership transfer)
      allow update: if isTeamOwner(teamId)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && request.resource.data.eventId == resource.data.eventId
                    && request.resource.data.accessCode == resource.data.accessCode
                    && (
                      // Allow team settings updates only
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'teamDisplayName',
                        'maxMembers',
                        'ownerUserId',
                        'memberUserIds',
                        'score',
                        'completedTaskIds',
                        'inventory',
                        'currentLocation',
                        'lastKnownPosition',
                        'updatedAt'
                      ])
                    );
      
      // ⚠️ DEVELOPMENT: Allow creates for test data setup
      // TODO: Change to 'if false' in production
      allow create: if true;
      allow delete: if false;
    }
    
    // ====================================
    // TASKS COLLECTION (Read-Only for Teams)
    // ====================================
    
    match /tasks/{taskId} {
      // Teams can read tasks for their event
      // Query MUST include tenantId filter (or open in dev)
      allow read: if isAuthenticated() 
                  || true; // ⚠️ DEVELOPMENT: Open read access
      
      // ⚠️ DEVELOPMENT: Allow writes for test data setup
      // TODO: Change to 'if false' in production
      allow write: if true;
    }
    
    // ====================================
    // TASK SUBMISSIONS
    // ====================================
    
    match /submissions/{submissionId} {
      // Teams can read their own submissions
      allow read: if isAuthenticated() 
                  && isTeamMember(resource.data.teamId);
      
      // Users can submit photos/videos for tasks (must be team member)
      allow create: if isAuthenticated()
                    && isTeamMember(request.resource.data.teamId)
                    && request.auth.uid == request.resource.data.userId
                    && belongsToTenant(request.resource.data.tenantId);
      
      // Only Cloud Functions can approve/reject (update status, award points)
      allow update, delete: if false;
    }
    
    // ====================================
    // USERS COLLECTION (User Profiles)
    // ====================================
    
    match /users/{userId} {
      // Users can read their own profile
      // NOTE: Query access is restricted - users can only read their own doc
      // Email-based lookup is handled server-side or after authentication
      allow read: if isUserOwner(userId);
      
      // Allow listing/querying for authenticated users
      // This enables features like viewing team members
      allow list: if isAuthenticated();
      
      // ⚠️ DEVELOPMENT: Simplified create rule for debugging
      // Allow authenticated users to create their own user document
      allow create: if isAuthenticated() 
                    && request.auth.uid == userId;
      
      // Users can update their own profile (displayName, email, consentGiven)
      // Cannot change uid or id fields
      allow update: if isUserOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'displayName',
                      'email',
                      'consentGiven',
                      'updatedAt',
                      'lastLoginAt',
                      'totalScore',
                      'totalSubmissions',
                      'eventsParticipated'
                    ]);
      
      // Users can delete their own profile (GDPR compliance)
      allow delete: if isUserOwner(userId);
    }
    
    // ====================================
    // TEAM MEMBERS COLLECTION
    // ====================================
    
    match /teamMembers/{teamMemberId} {
      // Team members can read individual membership documents
      allow get: if isAuthenticated() 
                 && isTeamMember(resource.data.teamId);
      
      // Users can query their own team memberships across events
      // This enables getUserTeamsInEvent() to work
      allow list: if isAuthenticated()
                  && request.query.limit != null
                  && request.query.limit <= 100;
      
      // Users can create their own team membership when joining
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.userId
                    && isTeamMember(request.resource.data.teamId);
      
      // Team members can update their own membership record (personal score)
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'personalScore',
                      'updatedAt'
                    ]);
      
      // Users can leave team (delete their membership)
      allow delete: if isAuthenticated()
                    && request.auth.uid == resource.data.userId;
    }
    
    // ====================================
    // LEADERBOARD (Public Read-Only)
    // ====================================
    
    match /leaderboard/{eventId}/entries/{teamId} {
      // Public leaderboard (real-time rankings)
      allow read: if true;
      
      // Only via Cloud Functions (recalculated on task completion)
      allow write: if false;
    }
    
    // ====================================
    // ADMIN USER PROFILES (Organizers)
    // ====================================
    
    match /admins/{userId} {
      // Admin users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Only via Admin SDK
      allow write: if false;
    }
    
    // ====================================
    // STRIPE INTEGRATION (Payments)
    // ====================================
    
    match /customers/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      
      match /checkout_sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }
      
      match /subscriptions/{subscriptionId} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
      }
    }
    
    // ====================================
    // DEFAULT DENY
    // ====================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
