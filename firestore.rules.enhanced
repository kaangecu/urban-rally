rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    
    /**
     * Check if user is authenticated
     */
    function isAuthenticated() {
      return request.auth != null;
    }
    
    /**
     * Check if authenticated user is linked to a specific team
     */
    function isTeam(teamId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/teams/$(teamId)).data.uid == request.auth.uid;
    }
    
    /**
     * Check if resource belongs to tenant
     */
    function belongsToTenant(tenantId) {
      return resource.data.tenantId == tenantId;
    }
    
    /**
     * Check if task is active
     */
    function isTaskActive() {
      return resource.data.isActive == true;
    }
    
    /**
     * Check if task is unlocked (time-based)
     */
    function isTaskUnlocked() {
      return !('unlockAt' in resource.data) || 
             resource.data.unlockAt <= request.time;
    }
    
    // ============================================================
    // TENANTS
    // ============================================================
    
    match /tenants/{tenantId} {
      // Anyone can read active tenants (public info)
      allow read: if resource.data.isActive == true;
      
      // Only admins can write (add admin check here)
      allow write: if false;
    }
    
    // ============================================================
    // EVENTS
    // ============================================================
    
    match /events/{eventId} {
      // Anyone can read active events
      allow read: if resource.data.isActive == true;
      
      // Only admins can write
      allow write: if false;
    }
    
    // ============================================================
    // TEAMS
    // ============================================================
    
    match /teams/{teamId} {
      // Teams can read their own data
      allow read: if isTeam(teamId);
      
      // Teams can update their own profile (limited fields)
      allow update: if isTeam(teamId) && 
                       onlyUpdatingAllowedFields([
                         'displayName',
                         'email',
                         'profilePhotoUrl',
                         'teamName',
                         'teamDisplayName',
                         'lastKnownPosition',
                         'updatedAt'
                       ]);
      
      // No create/delete by users
      allow create, delete: if false;
      
      // Purchased hints subcollection
      match /purchasedHints/{hintId} {
        // Teams can read their own purchased hints
        allow read: if isTeam(teamId);
        
        // Teams can create new hint purchases (validated)
        allow create: if isTeam(teamId) &&
                         request.resource.data.teamId == teamId &&
                         request.resource.data.cost >= 0;
        
        // No update/delete
        allow update, delete: if false;
      }
    }
    
    /**
     * Helper to check if only allowed fields are being updated
     */
    function onlyUpdatingAllowedFields(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(allowedFields);
    }
    
    // ============================================================
    // TASKS
    // ============================================================
    
    match /tasks/{taskId} {
      // Anyone can read active and unlocked tasks
      allow read: if isTaskActive() && isTaskUnlocked();
      
      // Only admins can write tasks
      allow write: if false;
      
      // Hints subcollection
      match /hints/{hintId} {
        // Teams can read hints (but need to purchase first via Cloud Function)
        allow read: if isAuthenticated();
        
        // Only admins/Cloud Functions can write
        allow write: if false;
      }
    }
    
    // ============================================================
    // SUBMISSIONS
    // ============================================================
    
    match /submissions/{submissionId} {
      // Teams can read their own submissions
      allow read: if isAuthenticated() && 
                     resource.data.teamId == request.auth.uid;
      
      // Teams can create submissions (with validation)
      allow create: if isAuthenticated() &&
                       request.resource.data.teamId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.pointsAwarded >= 0;
      
      // Only Cloud Functions can update submissions (approval/rejection)
      allow update: if false;
      
      // No delete
      allow delete: if false;
    }
    
    // ============================================================
    // LEADERBOARD
    // ============================================================
    
    match /leaderboard/{entryId} {
      // Anyone can read leaderboard
      allow read: if true;
      
      // Only Cloud Functions can write
      allow write: if false;
    }
    
    // ============================================================
    // USER PROFILES (Admins/Organizers)
    // ============================================================
    
    match /userProfiles/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Only super admins can write
      allow write: if false;
    }
  }
}
