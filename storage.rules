rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isValidImageSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB max
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    
    function isValidVideoSize() {
      return request.resource.size < 50 * 1024 * 1024; // 50MB max for videos
    }
    
    // Check if user's UID matches the team's UID in Firestore
    function isTeamMember(teamId) {
      return isAuthenticated() 
             && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.uid == request.auth.uid;
    }
    
    // Task Submissions - path without fileName segment
    match /submissions/{tenantId}/{eventId}/{teamId}/{taskId} {
      allow write: if isTeamMember(teamId)
                   && ((isImage() && isValidImageSize()) || (isVideo() && isValidVideoSize()));
      // Only the submitting team; organizers review through the Admin SDK
      allow read: if isTeamMember(teamId);
    }
    
    // Team Photo Uploads (scoped by tenant and team)
    match /uploads/{tenantId}/{eventId}/{teamId}/{fileName} {
      // Teams can upload their own photos
      allow write: if isTeamMember(teamId)
                   && isImage()
                   && isValidImageSize();
      
      // Only the team itself; a public gallery needs explicit consent first
      allow read: if isTeamMember(teamId);
    }
    
    // Tenant Logos (Admin only, public read)
    match /tenants/{tenantId}/logo/{fileName} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }
    
    // Sponsor Logos (Admin only, public read)
    match /sponsors/{sponsorId}/{fileName} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }
    
    // Default: Deny all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
