rules_version = '2';

// ⚠️ DEVELOPMENT RULES - DO NOT USE IN PRODUCTION ⚠️
// These rules allow open writes for testing and development
// Deploy with: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ====================================
    // DEVELOPMENT MODE - RELAXED RULES
    // ====================================
    
    // TENANTS - Allow writes for setup script
    match /tenants/{tenantId} {
      allow read, write: if true;
    }
    
    // EVENTS - Allow writes for setup script
    match /events/{eventId} {
      allow read, write: if true;
    }
    
    // TEAMS - Allow writes for setup script
    match /teams/{teamId} {
      allow read, write: if true;
    }
    
    // TASKS - Allow writes for setup script
    match /tasks/{taskId} {
      allow read, write: if true;
    }
    
    // SUBMISSIONS - Allow writes for testing
    match /submissions/{submissionId} {
      allow read, write: if true;
    }
    
    // LEADERBOARD - Allow writes for testing
    match /leaderboard/{entryId} {
      allow read, write: if true;
    }
    
    // HINTS - Allow writes for testing
    match /hints/{hintId} {
      allow read, write: if true;
    }
  }
}
