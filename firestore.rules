rules_version = '2';

// Production rules. Clients are never trusted with game state:
// content (tenants, events, tasks), team creation, team login (uid binding),
// scoring and leaderboard writes happen only through the Admin SDK
// (seed scripts today, Cloud Functions later). Tested in tests/rules/.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // The signed-in user is bound to this team document.
    function ownsTeam(teamData) {
      return isAuthenticated() && teamData.uid == request.auth.uid;
    }

    function isTeamMember(teamId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/teams/$(teamId)).data.uid == request.auth.uid;
    }

    // ====================================
    // CONTENT: public branding and event data, admin-only writes
    // ====================================

    match /tenants/{tenantId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /tasks/{taskId} {
      // TODO: quiz answers are still stored on the task document; they move
      // to an admin-only location when answer checking moves server-side.
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ====================================
    // TEAMS: a team can only see and edit itself
    // ====================================

    match /teams/{teamId} {
      // Covers queries too: a list only succeeds when every result is the
      // caller's own team, so the collection cannot be enumerated.
      allow read: if ownsTeam(resource.data);

      // Profile fields only. Identity (uid, accessCode, tenantId, eventId)
      // and game state (score, completedTaskIds, inventory) are server-owned.
      allow update: if ownsTeam(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'email',
          'profilePhotoUrl',
          'teamDisplayName',
          'consentGiven',
          'currentLocation',
          'lastKnownPosition',
          'lastLoginAt',
          'updatedAt'
        ]);

      allow create, delete: if false;
    }

    // ====================================
    // SUBMISSIONS: teams submit for review, never approve themselves
    // ====================================

    match /submissions/{submissionId} {
      allow read: if isTeamMember(resource.data.teamId);

      allow create: if isTeamMember(request.resource.data.teamId)
        && request.resource.data.tenantId == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.tenantId
        && request.resource.data.status == 'pending'
        && !('pointsAwarded' in request.resource.data);

      allow update, delete: if false;
    }

    // ====================================
    // LEADERBOARD: public read, server writes
    // ====================================

    match /leaderboard/{eventId}/entries/{teamId} {
      allow read: if true;
      allow write: if false;
    }

    // ====================================
    // ORGANIZER PROFILES
    // ====================================

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
