rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ====================================
    // HELPER FUNCTIONS
    // ====================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isTeamOwner(teamId) {
      return isAuthenticated() && request.auth.uid == get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUserId;
    }
    
    function isTeamMember(teamId) {
      return isAuthenticated() 
          && exists(/databases/$(database)/documents/teams/$(teamId))
          && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUserIds;
    }
    
    function isUserOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function belongsToTenant(tenantId) {
      return request.resource.data.tenantId == tenantId;
    }
    
    // CRITICAL: All queries MUST include tenantId filter to prevent cross-tenant data leaks
    function hasTenantIdInQuery() {
      return request.query.limit == null || 'tenantId' in request.query;
    }
    
    // NEW: Multi-event validation helpers
    function isValidEvent(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
          && get(/databases/$(database)/documents/events/$(eventId)).data.isActive == true;
    }
    
    function isValidTenant(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId))
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.isActive == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check if only specific fields are being updated
    function onlyUpdatingFields(allowedFields) {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return affectedKeys.hasOnly(allowedFields);
    }
    
    // ====================================
    // TENANTS COLLECTION
    // ====================================
    
    match /tenants/{tenantId} {
      // Public read for branding (logo, colors, name)
      allow read: if true;
      
      // ⚠️ DEVELOPMENT: Allow writes for test data setup
      // TODO: Change to 'if false' in production
      allow write: if true;
    }
    
    // ====================================
    // EVENTS COLLECTION
    // ====================================
    
    match /events/{eventId} {
      // Public read for active events (map bounds, start/end dates)
      allow read: if true;
      
      // ⚠️ DEVELOPMENT: Allow writes for test data setup
      // TODO: Change to 'if false' in production
      allow write: if true;
    }
    
    // ====================================
    // TEAMS COLLECTION (Strict Isolation)
    // ====================================
    
    match /teams/{teamId} {
      // Allow reading by accessCode for login (before auth)
      // OR if user is a team member (after auth)
      allow read: if isTeamMember(teamId) 
                  || (!isAuthenticated() && request.query != null)
                  || true; // ⚠️ DEVELOPMENT: Open read access
      
      // 🔒 HYBRID SECURITY: Allow limited updates for existing features
      // Only team members can update, and only specific fields
      allow update: if isAuthenticated()
                    && isTeamMember(teamId)
                    && request.resource.data.tenantId == resource.data.tenantId
                    && request.resource.data.eventId == resource.data.eventId
                    && onlyUpdatingFields(['score', 'completedTaskIds', 'currentLocation', 'updatedAt', 'memberUserIds', 'memberCount']);
      
      // ⚠️ DEVELOPMENT: Allow creates for test data setup
      // TODO: Change to 'if false' in production
      allow create: if true;
      allow delete: if false;
    }
    
    // ====================================
    // TASKS COLLECTION (Read-Only for Teams)
    // ====================================
    
    match /tasks/{taskId} {
      // Teams can read tasks for their event
      // Query MUST include tenantId filter (or open in dev)
      allow read: if isAuthenticated() 
                  || true; // ⚠️ DEVELOPMENT: Open read access
      
      // ⚠️ DEVELOPMENT: Allow writes for test data setup
      // TODO: Change to 'if false' in production
      allow write: if true;
    }
    
    // ====================================
    // TASK SUBMISSIONS
    // ====================================
    
    match /submissions/{submissionId} {
      // Teams can read their own individual submissions
      allow get: if isAuthenticated() 
                  && isTeamMember(resource.data.teamId);
      
      // Admins can list submissions for events they manage
      allow list: if isModerator();
      
      // ⚠️ DEVELOPMENT: Temporarily open for debugging
      // Users can submit photos/videos for tasks (must be team member)
      allow create: if isAuthenticated()
                    && request.auth.uid == request.resource.data.userId
                    && belongsToTenant(request.resource.data.tenantId);
      
      // Only Cloud Functions can approve/reject (update status, award points)
      allow update, delete: if false;
    }
    
    // ====================================
    // USERS COLLECTION (User Profiles)
    // ====================================
    
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Admins can query users for management (NEW: unified schema)
      // Super admins can see all users, admins can see users in their tenants
      allow list: if isSuperAdmin() 
                  || (hasAdminRole() && isAuthenticated());
      
      // 🔒 HYBRID SECURITY: Allow profile updates but prevent critical field changes
      allow update: if isOwner(userId)
                    && !('tenantId' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('id' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('accountType' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('managedTenantIds' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('isActive' in request.resource.data.diff(resource.data).affectedKeys());
      
      // Only Cloud Function can create users and manage admin fields
      allow create: if false;
      allow delete: if isUserOwner(userId);
    }
    
    // ====================================
    // TEAM MEMBERS COLLECTION
    // ====================================
    
    match /teamMembers/{teamMemberId} {
      // 🔒 SECURITY FIX: Users can only read their own memberships
      // Prevents privacy leak of all team memberships
      allow read: if isAuthenticated() 
                  && request.auth.uid == resource.data.userId;
      
      // 🔒 HYBRID SECURITY: Only Cloud Functions can create/delete
      // But allow updates for stats (low security risk)
      allow create: if false;  // Only joinTeamSecure
      allow delete: if false;  // Only leaveTeamSecure
      
      // Allow members to update their own stats
      allow update: if isAuthenticated()
                    && request.auth.uid == resource.data.userId
                    && !('teamId' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('userId' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('eventId' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('tenantId' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys());
    }
    
    // ====================================
    // LEADERBOARD (Public Read-Only)
    // ====================================
    
    match /leaderboard/{eventId}/entries/{teamId} {
      // Public leaderboard (real-time rankings)
      allow read: if true;
      
      // Only via Cloud Functions (recalculated on task completion)
      allow write: if false;
    }
    
    // ====================================
    // ADMIN USER PROFILES (Organizers)
    // ====================================
    
    match /admins/{userId} {
      // Admin users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Only via Admin SDK
      allow write: if false;
    }
    
    // ====================================
    // STRIPE INTEGRATION (Payments)
    // ====================================
    
    match /customers/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      
      match /checkout_sessions/{sessionId} {
        allow read, write: if isAuthenticated() && request.auth.uid == uid;
      }
      
      match /subscriptions/{subscriptionId} {
        allow read: if isAuthenticated() && request.auth.uid == uid;
      }
    }
    
    // ====================================
    // ADMIN MANAGEMENT
    // ====================================
    
    // Admin helper functions
    function hasAdminRole() {
      return isAuthenticated() && request.auth.token.role != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'superadmin';
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role in ['superadmin', 'admin'];
    }
    
    function isOrganizer() {
      return isAuthenticated() && request.auth.token.role in ['superadmin', 'admin', 'organizer'];
    }
    
    function isModerator() {
      return isAuthenticated() && request.auth.token.role in ['superadmin', 'admin', 'organizer', 'moderator'];
    }
    
    function canManageTenant(tenantId) {
      return isSuperAdmin() || (hasAdminRole() && tenantId in request.auth.token.tenantIds);
    }
    
    // Audit Logs (Admin actions)
    match /auditLogs/{logId} {
      // Only Cloud Functions can write audit logs
      allow create, update, delete: if false;
      
      // Super admins can read all logs
      allow read: if isSuperAdmin();
      
      // Admins can read logs for their tenants
      allow read: if isAdmin() && canManageTenant(resource.data.tenantId);
    }
    
    // ====================================
    // DEFAULT DENY
    // ====================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
