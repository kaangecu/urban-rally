{
  "name": "urban-rally",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-tenant scavenger hunt PWA for international student organizations",
  "author": "UrbanRally Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "setup-test-data": "tsx src/scripts/setup-test-data.ts",
    "add-event": "tsx scripts/add-event.ts",
    "add-tasks": "tsx scripts/add-quiz-photo-tasks.ts",
    "add-teams": "tsx scripts/add-teams.ts",
    "setup-all": "npm run add-event && npm run add-tasks && npm run add-teams",
    "dev-setup": "./scripts/dev-setup.sh",
    "migrate:dry-run": "tsx scripts/migrate-database.ts",
    "migrate:live": "tsx scripts/migrate-database.ts --live",
    "migrate:rollback": "tsx scripts/migrate-database.ts --rollback",
    "migrate-users": "tsx scripts/migrate-to-user-system.ts --dry-run",
    "migrate-users:execute": "tsx scripts/migrate-to-user-system.ts --execute",
    "migrate-users:verify": "tsx scripts/migrate-to-user-system.ts --verify",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:rules:dev": "firebase deploy --only firestore:rules",
    "deploy:rules:prod": "cp firestore.rules.prod firestore.rules && firebase deploy --only firestore:rules",
    "deploy:rules:enhanced": "cp firestore.rules.enhanced firestore.rules && firebase deploy --only firestore:rules",
    "firebase:backup-rules": "firebase firestore:rules get > firestore.backup.rules",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.2.3",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.25",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "string-similarity": "^4.0.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^10.1.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/string-similarity": "^4.0.2",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "msw": "^2.12.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
