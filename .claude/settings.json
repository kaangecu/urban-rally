{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(firebase deploy *)",
      "Bash(npx firebase deploy *)",
      "Bash(npm run deploy*)",
      "Bash(npm run migrate*)",
      "Bash(npx tsx scripts/migrate-database.ts *)",
      "Bash(npm run setup-*)",
      "Bash(npm run add-*)",
      "Bash(npx tsx scripts/*)",
      "Bash(tsx scripts/*)",
      "Bash(*scripts/setup-testing.sh*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(* --no-verify*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm uninstall *)",
      "Bash(npm update*)",
      "Bash(git push*)",
      "Edit(/.github/**)",
      "Edit(/firestore.rules)",
      "Edit(/storage.rules)",
      "Edit(**/*.test.ts)",
      "Edit(**/*.test.tsx)",
      "Edit(**/*.spec.ts)",
      "Edit(**/__tests__/**)",
      "Edit(/tests/**)",
      "Edit(/e2e/**)",
      "Bash(gh pr create*)",
      "Bash(gh api *)"
    ]
  },
  "outputStyle": "Learning",
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail",
        "ref": "v5.3.2"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-file.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-before-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
